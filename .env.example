# Copy to .env and fill in real values. Keep .env out of version control.

# Unraid GraphQL endpoint. On the Unraid box itself use the LAN IP or localhost.
UNRAID_API_URL=http://192.168.8.186:8080/graphql

# Unraid API key (VIEWER role recommended). Created with:
#   unraid-api apikey --create --name "OpenWebUI Bridge" --description "Open WebUI read-only bridge" --roles VIEWER --json
UNRAID_API_KEY=

# Token that Open WebUI (and any other client) must present as
# Authorization: Bearer <token>  or  X-API-Key: <token>.
# Leave empty to disable bridge auth (LAN only, not recommended).
BRIDGE_API_KEY=
